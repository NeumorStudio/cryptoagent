# Clave de la API de Anthropic (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Modelo que usa el agente
MODEL=claude-opus-5
# Esfuerzo de razonamiento: low | medium | high | xhigh | max
EFFORT=high

# Capital inicial simulado en USD. Se entrega en USDC en el monedero de Solana,
# salvo INITIAL_SOL, que se compra al precio real al empezar (hace falta SOL para pagar la red)
INITIAL_USD=1000
INITIAL_SOL=0.05

# Coste de red por transacción en Solana, en SOL (fee base + priority fee)
SOLANA_TX_FEE_SOL=0.0001
# Comisión taker de Binance spot (0.001 = 0,1 %)
BINANCE_TAKER_FEE=0.001
# Comisión de retirada de USDC desde Binance por la red Solana
BINANCE_USDC_WITHDRAW_FEE=0.3

# Máximo de llamadas al modelo por sesión
MAX_STEPS_PER_SESSION=80
# En modo --loop, minutos de pausa entre sesiones
LOOP_PAUSE_MINUTES=30
# Cada cuántos segundos se comprueban las órdenes condicionales
WATCH_INTERVAL_SECONDS=60
# true = ver el navegador en pantalla
BROWSER_HEADFUL=false
