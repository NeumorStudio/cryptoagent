# Clave de la API de Anthropic (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Modelo que usa el agente
MODEL=claude-opus-5
# Esfuerzo de razonamiento: low | medium | high | xhigh | max
EFFORT=high

# Capital inicial simulado en USD (si la misión no indica otro). Se reparte entre las cadenas y Binance;
# en cada cadena, una parte llega en su token nativo para pagar la red.
INITIAL_USD=1000

# Coste de red por transacción en Solana, en SOL (fee base + priority fee)
SOLANA_TX_FEE_SOL=0.0001
# Comisión taker de Binance spot (0.001 = 0,1 %)
BINANCE_TAKER_FEE=0.001
# Comisión de retirada de USDC desde Binance por la red Solana
BINANCE_USDC_WITHDRAW_FEE=0.3

# Máximo de llamadas al modelo por sesión
MAX_STEPS_PER_SESSION=80
# En modo --loop, minutos de pausa entre sesiones
LOOP_PAUSE_MINUTES=30
# Cada cuántos segundos se comprueban las órdenes condicionales
WATCH_INTERVAL_SECONDS=60
# true = ver el navegador en pantalla
BROWSER_HEADFUL=false

# Fase 1 (experimental): órdenes trailing (trailing_stop / trailing_tp en place_swap_trigger_order)
ENABLE_TRAILING_ORDERS=false

# Fase 2 (experimental): carril rápido del monitor (reacciona al segundo a las órdenes trailing).
# Cuidado: consume cotizaciones de Jupiter (1 req/s compartido). FAST_MONITOR_QUOTES_PER_TICK limita cuántas
# cotizaciones distintas por tick.
ENABLE_FAST_MONITOR=false
MONITOR_FAST_SECONDS=1
FAST_MONITOR_QUOTES_PER_TICK=1
